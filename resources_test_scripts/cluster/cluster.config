// Only the login-side common preparation run uses this configuration.
includeConfig '../../src/workflows/utils/labels.config'

process {
  executor = 'slurm'
  queue = 'cpu1,cpu2'
  time = 8.h
}

singularity {
  enabled = true
  autoMounts = true
  // Mirror unqualified publish images, not the fully qualified GHCR tool image.
  registry = 'dockerproxy.net'
  ociAutoPull = false
  // Leave ociMode unset: false emits --no-oci, unsupported by the cluster's Apptainer CLI.
}
docker.enabled = false
