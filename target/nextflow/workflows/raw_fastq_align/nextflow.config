manifest {
  name = 'workflows/raw_fastq_align'
  mainScript = 'main.nf'
  nextflowVersion = '!>=20.12.1-edge'
  version = 'main_build'
  description = 'Process paired raw FOODIE FASTQs through raw FastQC/statistics, fditools barcode\nextraction, extracted FastQC, Rust Trim Galore and first-pass Rust Bismark.\nSupply a prepared Bismark genome directory containing reference FASTAs and indexes.\nThe BAM preserves terminal _CB:Z:<barcode> QNAME suffixes and has no CB auxiliary\ntags. Pass it directly as input to workflows/consensus_dedup with the same genome.\nFixed extraction uses match length 11, skip length 19 and the supplied whitelist.\nTrimming uses quality 20, stringency 2, error rate 0.1, legacy three-adapter\nselection and no automatic poly-G trimming. Alignment is non-directional, maxins 2000.\nQC lists are ordered R1 then R2; published wildcard indices are 0 and 1.\n\nfdi 0.1.0 is built from the public MIT-licensed fditools source tag 0.1.0\nusing pinned Rust 1.97.1 and Cargo.lock in a separate Docker build stage.\nBarcodes concatenate the matched halves without a separator.\nRebuild with `viash build src/components/fditools/config.vsh.yaml --setup cachedbuild`.\nNo release credentials or local legacy/ directory are required. CI publishing\nrequires public GHCR image visibility. Linux x86-64/glibc only; ARM and musl are unsupported.\nRust Trim Galore is pinned to 2.3.0. The test-only compatibility baseline is\nofficial Perl Trim Galore 0.6.11 with Cutadapt 5.2, independently auto-selecting\nits adapter on every complete extracted regional sample.\n\nBuild with `viash ns build --parallel --setup cachedbuild`, then for example:\n`nextflow run target/nextflow/workflows/raw_fastq_align/main.nf -profile docker\n--id sample --read1 sample.R1.fastq.gz --read2 sample.R2.fastq.gz\n--whitelist assets/barcodes.txt --genome resources_test/common/genome`.\nIn a composed workflow, pass `[id, [id: id, input: producer.output_bam,\ngenome: genome]]` directly to consensus_dedup.run. The producer does not\nsort, index, add CB tags, call cells or deduplicate. The consumer owns those steps.\n\nGenerate common first on cluster login with\n`bash resources_test_scripts/cluster/common.sh --resources-dir <root>`.\nCommon independently owns the full chr14 genome and unchanged external cell\nlists. Submit original-raw generation on a cpu1/cpu2 cluster allocation with\n`sbatch resources_test_scripts/cluster/generate/raw_fastq_align.sh --resources-dir <root>`.\nIt requires source access, Python 3, samtools >=1.12 and bqtools 0.6.1.\nPython independently checks every original pair through EOF and audits selected\noriginals before bqtools encodes the gzipped R1/R2 files directly. CBQ header\ngrep determines matching identities and validates their full headers, sequences\nand qualities against the audits. Final fixtures use those original audits,\npreserving all four lines verbatim and source order. Auditing and encoding each\nread the full original sources. LF and CRLF originals retain their line endings.\nPrivate full-source CBQ files remain in <root>/.raw_fastq_align_cbq\n(or RAW_FASTQ_ALIGN_CBQ_CACHE), with private source/count metadata and archive paths.\nThey are not regional test fixtures and are not transferred.\nGenerators refuse existing final directories and stage privately on shared storage.\nPublication uses exclusive directory creation and hard links, with completion last.\nIncomplete final directories fail validation and require explicit cleanup. Schema 3\nbinds regional files to common\'s payload hashes. No per-sample provenance files\nare distributed; original/CBQ/final gzip checks remain generation-time checks.\nNever reuse partial gzip files or incomplete staging directories.\nShell tools default to the checkout\'s resources_test root.\n\nLocally, download common first with `bash resources_test_scripts/local/download.sh\ncommon --resources-dir <root>`, then download raw_fastq_align with the same command.\nRun `src/workflows/raw_fastq_align/integration_test.sh --resources_test <root>`\nfor both original-raw samples, full Perl/Rust parity and unchanged BAM handoff\ninto consensus_dedup with common\'s cell lists. No consensus BAM fixtures are\nneeded. Python 3 is required on the Nextflow test controller, which validates\ncompletion, payload hashes and common dependencies before submitting tasks.\nResume failed Nextflow tasks with `-resume`. See resources_test_scripts/README.md\nfor generation, selected-set OSS transfers and failure recovery.\n'
  author = 'Zhang Zhen'
}

process.container = 'nextflow/bash:latest'

// detect tempdir
tempDir = java.nio.file.Paths.get(
  System.getenv('NXF_TEMP') ?:
    System.getenv('VIASH_TEMP') ?: 
    System.getenv('TEMPDIR') ?: 
    System.getenv('TMPDIR') ?: 
    '/tmp'
).toAbsolutePath()

profiles {
  no_publish {
    process {
      withName: '.*' {
        publishDir = [
          enabled: false
        ]
      }
    }
  }
  mount_temp {
    docker.temp            = tempDir
    podman.temp            = tempDir
    charliecloud.temp      = tempDir
  }
  docker {
    docker.enabled         = true
    // docker.userEmulation   = true
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    docker.enabled         = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  podman {
    podman.enabled         = true
    docker.enabled         = false
    singularity.enabled    = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  shifter {
    shifter.enabled        = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    charliecloud.enabled   = false
  }
  charliecloud {
    charliecloud.enabled   = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
  }
}

process{
  withLabel: mem1gb { memory = 1000000000.B }
  withLabel: mem2gb { memory = 2000000000.B }
  withLabel: mem5gb { memory = 5000000000.B }
  withLabel: mem10gb { memory = 10000000000.B }
  withLabel: mem20gb { memory = 20000000000.B }
  withLabel: mem50gb { memory = 50000000000.B }
  withLabel: mem100gb { memory = 100000000000.B }
  withLabel: mem200gb { memory = 200000000000.B }
  withLabel: mem500gb { memory = 500000000000.B }
  withLabel: mem1tb { memory = 1000000000000.B }
  withLabel: mem2tb { memory = 2000000000000.B }
  withLabel: mem5tb { memory = 5000000000000.B }
  withLabel: mem10tb { memory = 10000000000000.B }
  withLabel: mem20tb { memory = 20000000000000.B }
  withLabel: mem50tb { memory = 50000000000000.B }
  withLabel: mem100tb { memory = 100000000000000.B }
  withLabel: mem200tb { memory = 200000000000000.B }
  withLabel: mem500tb { memory = 500000000000000.B }
  withLabel: mem1gib { memory = 1073741824.B }
  withLabel: mem2gib { memory = 2147483648.B }
  withLabel: mem4gib { memory = 4294967296.B }
  withLabel: mem8gib { memory = 8589934592.B }
  withLabel: mem16gib { memory = 17179869184.B }
  withLabel: mem32gib { memory = 34359738368.B }
  withLabel: mem64gib { memory = 68719476736.B }
  withLabel: mem128gib { memory = 137438953472.B }
  withLabel: mem256gib { memory = 274877906944.B }
  withLabel: mem512gib { memory = 549755813888.B }
  withLabel: mem1tib { memory = 1099511627776.B }
  withLabel: mem2tib { memory = 2199023255552.B }
  withLabel: mem4tib { memory = 4398046511104.B }
  withLabel: mem8tib { memory = 8796093022208.B }
  withLabel: mem16tib { memory = 17592186044416.B }
  withLabel: mem32tib { memory = 35184372088832.B }
  withLabel: mem64tib { memory = 70368744177664.B }
  withLabel: mem128tib { memory = 140737488355328.B }
  withLabel: mem256tib { memory = 281474976710656.B }
  withLabel: mem512tib { memory = 562949953421312.B }
  withLabel: cpu1 { cpus = 1 }
  withLabel: cpu2 { cpus = 2 }
  withLabel: cpu5 { cpus = 5 }
  withLabel: cpu10 { cpus = 10 }
  withLabel: cpu20 { cpus = 20 }
  withLabel: cpu50 { cpus = 50 }
  withLabel: cpu100 { cpus = 100 }
  withLabel: cpu200 { cpus = 200 }
  withLabel: cpu500 { cpus = 500 }
  withLabel: cpu1000 { cpus = 1000 }
}

includeConfig("nextflow_labels.config")
